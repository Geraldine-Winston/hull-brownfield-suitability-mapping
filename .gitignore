# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environment
venv/
.venv/
env/

# Environment variables
.env

# GIS / ArcGIS junk files
*.sr.lock
*.lock

# OS
.DS_Store
Thumbs.db

# Office lock files
~$*.doc*
~$*.xls*

# IDE
.vscode/
.idea/

# Large / generated outputs (keep small figures, ignore bulky exports if needed)
outputs/*.gpkg
outputs/*.tif

# Data - raw data is small enough (~24MB) to commit. Processed/derived
# .gpkg outputs are also committed (not ignored) so the Streamlit app has
# data/processed/suitability_grid_100m.gpkg available on a fresh deploy
# (e.g. Streamlit Community Cloud), which only has the git repo - not a
# local pipeline run. Regenerate them locally with:
#   python -m src.reproject_boundary && python -m src.suitability_pipeline
