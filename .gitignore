# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environment
venv/
.venv/
env/

# Environment variables
.env

# GIS / ArcGIS junk files
*.sr.lock
*.lock

# OS
.DS_Store
Thumbs.db

# Office lock files
~$*.doc*
~$*.xls*

# IDE
.vscode/
.idea/

# Large / generated outputs (keep small figures, ignore bulky exports if needed)
outputs/*.gpkg
outputs/*.tif

# Data - raw data is small enough (~24MB) to commit; processed/derived
# intermediate files can be regenerated by the pipeline, so ignore them.
data/processed/*
!data/processed/.gitkeep
